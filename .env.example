# .env.example — salin ke .env dan isi semua nilai
# JANGAN commit .env ke git
#
# ADD (GMI_Decision_Document_v3.docx, Decision A / Next Steps §1):
# File ini sudah dispesifikasikan penuh di IDD v1.0 §8.5 tapi tidak pernah
# dibuat di repo manapun — bukan regresi, gap orisinal. Isi di bawah
# direkonsiliasi terhadap seluruh os.getenv()/os.environ.get() call site
# nyata di src/ (grep empiris), bukan disalin buta dari IDD.
#
# BIS CBPOL_D (bronze_bis_rates) TIDAK memerlukan API key — free, no
# registration (Data Source & Rates Adjustment v1.0 §3.2). Sengaja tidak
# ada entry untuk itu di bawah.
#
# FIX ADR-043 (GMI_Decision_Document_v10.docx, 22 Aug 2026): FINNHUB_API_KEY
# dihapus dari file ini. Finnhub diretired penuh — tidak ada os.getenv()
# call site yang membacanya lagi di src/ manapun (reconciliation grep sweep
# re-run saat fix ini, mengikuti prinsip file ini sendiri di atas).

# ── Macro Economics — FRED, BLS, BEA, EIA (semua butuh free API key) ──────────
FRED_API_KEY=your_fred_key_here
BLS_API_KEY=your_bls_key_here
BEA_API_KEY=your_bea_key_here
EIA_API_KEY=your_eia_key_here

# ── Market Data ────────────────────────────────────────────────────────────
ALPHAVANTAGE_API_KEY=your_av_key_here
POLYGON_API_KEY=your_polygon_key_here

# ── Optional — Telegram alert dari health_reporter ────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Pipeline config ────────────────────────────────────────────────────────
# Override root direktori semua layer data/ (bronze/silver/gold/health).
# Default jika tidak di-set: turunan dari get_config().silver_path.parent
# (lihat src/silver/active_symbols.py, context_anchors.py).
PIPELINE_DATA_ROOT=data
